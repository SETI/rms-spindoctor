    <File_Area_Ancillary>
        <File>
            <file_name>global_rings_index.tab</file_name>
            <creation_date_time>$FILE_ZULU(INDEX_TABLE_PATH)$</creation_date_time>
            <file_size unit="byte">$FILE_BYTES(INDEX_TABLE_PATH)$</file_size>
            <md5_checksum>$FILE_MD5(INDEX_TABLE_PATH)$</md5_checksum>
        </File>
        <Header>
            <offset unit="byte">0</offset>
            <object_length unit="byte">$HEADER_LENGTH$</object_length>
            <parsing_standard_id>7-Bit ASCII Text</parsing_standard_id>
            <description>
                One line naming the table's fields, in order, separated by commas.
            </description>
        </Header>
        <Table_Character>
            <local_identifier>global_rings_index</local_identifier>
            <offset unit="byte">$HEADER_LENGTH$</offset>
            <records>$FILE_RECORDS(INDEX_TABLE_PATH)-1$</records>
            <description>
                One row for each image the data collection holds that has ring backplanes,
                giving the image's data product, the start and stop of its exposure, the
                least and the greatest value each ring backplane takes over the pixels
                where it has a value, the arc of ring longitude those pixels cover, wrapped
                at zero, and the least, the greatest and the mean incidence angle of
                sunlight on the ring plane over them. Every field is padded with spaces to
                its length and followed by a comma, the last by the line feed. Angles are
                in degrees, although the backplane arrays are in radians. A field holding
                its missing constant marks a value the image's backplanes do not record.
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>$len(FIELDS)$</fields>
                <groups>0</groups>
                <record_length unit="byte">$RECORD_LENGTH$</record_length>
                $FOR(field=FIELDS)
                <Field_Character>
                    <name>$field.column.name$</name>
                    <field_number>$field.number$</field_number>
                    <field_location unit="byte">$field.location$</field_location>
                    <data_type>$field.column.data_type$</data_type>
                    <field_length unit="byte">$field.length$</field_length>
                    $IF(field.column.unit is not None)
                    <unit>$field.column.unit$</unit>
                    $END_IF
                    <description>
                        $WRAP(24,91,field.column.description,preserve_single_newlines=False)$
                    </description>
                    $IF(field.column.missing_constant is not None)
                    <Special_Constants>
                        <missing_constant>$field.column.missing_constant$</missing_constant>
                    </Special_Constants>
                    $END_IF
                </Field_Character>
                $END_FOR
            </Record_Character>
        </Table_Character>
    </File_Area_Ancillary>
